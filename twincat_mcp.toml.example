# twincat-mcp configuration. Copy to ./twincat_mcp.toml (next to where the
# server is started), or to %USERPROFILE%\.twincat_mcp\config.toml, or point
# TCMCP_CONFIG at it. Environment variables TCMCP_* override these values.

[ads]
ams_net_id = "5.12.34.56.1.1"      # target IPC; omit for the local runtime
ams_port = 851                     # PLC runtime 1
timeout_ms = 5000
# static_routes_xml = 'C:\TwinCAT\3.1\Target\StaticRoutes.xml'
# ethercat_master_port = 65535

[xae]
solution_path = 'C:\Projects\DrumFilling\DrumFilling.sln'   # picks the right XAE instance
attach_only = true                 # never launch a shell unless xae_attach(launch=true)
# progids = ["TcXaeShell.DTE.15.0"]  # 4024 32-bit shell first, if that is what you run
build_timeout_s = 900
dialog_watchdog = true             # poll XAE modal dialogs; auto-answer only by the rules below
silent_mode = false                # TE1000 SilentMode only during confirmed machine commands (answers undocumented)
dialog_rules = [                   # never applied to activate/run/download/login/delete/safety prompts
  { title_contains = "Microsoft Visual Studio", text_contains = "save changes", button = "No" },
]
allow_safety = false               # TwinSAFE (TISC) edits refused unless true

[project]
# root = 'C:\Projects\DrumFilling'  # defaults to the solution folder
tcunit_remote_result = 'boot:TcUnit_xUnit_testresults.xml'   # 'boot:' = the target's boot folder whatever the OS (C:\TwinCAT\3.1\Boot, \Hard Disk\TwinCAT\3.1\Boot on CE7); an absolute path still works
# hmi_root = 'C:\Projects\DrumFilling\Hmi'   # TE2000 project folder for hmi_scan
[project.naming_prefixes]          # overrides for proj_lint's naming rule
LREAL = ["r", "lr", "f"]

[recorder]
engine = "auto"                    # cycle-mode recordings: auto = native C++ capture service (bin/tcmcp-capture.exe,
                                   # Beckhoff AdsLib on TcAdsDll) when it matches this version, else Python; native | python
# capture_exe = 'D:\Tools\tcmcp-capture.exe'   # only to use your own build instead of the shipped one
ring_s = 10.0                      # native: seconds of samples buffered between the ADS callback and the file
also_scope = "ask"                 # rec_start + a TwinCAT Scope configuration open in XAE: ask | always | never

[scope]
# export_tool = 'C:\Program Files (x86)\Beckhoff\TwinCAT\Functions\TE130X-Scope-View\TC3ScopeExportTool.exe'
# export_dir = 'D:\Recordings\scope'   # default: <recordings>\scope
# project = "Scope_Counter"          # the Scope configuration rec_start(also_scope=true) records; default: the only one open
# view_log = 'C:\ProgramData\Beckhoff\TwinCAT\Functions\TE130X-Scope-View\TcScopeView.log'   # (the default) new ERROR lines are reported

[server]
tool_groups = ["ads", "rec", "snap", "test", "proj", "xae", "infosys", "wf", "scope"]   # only these groups (tc_* always); remove the line for all
# output_dirs = ['D:\Exports']      # extra folders the tools may write files to (exports, dumps, reports). Always allowed:
#                                  # the recordings folder, the project and solution folders, the scope export folder,
#                                  # the experiments folder and the audit-log folder. Existing files need overwrite=true.

[safety]
mode = "guarded"                   # readonly | guarded | full  (start mode)
max_mode = "full"                  # ceiling for tc_set_mode at runtime
confirm_destructive = true         # false = activate/restart/reboot in one call (full mode)
confirm_ttl_s = 180
write_allowlist = ["GVL_Test.*", "MAIN.fbFill.stParams.*"]   # guarded mode: writable symbols — name FBs/structs, never "MAIN.*"
                                                              # (MAIN.* also covers every valve output under MAIN)
write_denylist  = ["*.bEStop*", "GVL_Safety.*"]            # never writable, any mode
audit_reads = false
allow_elicitation = false           # no in-chat confirm prompts: every approval is a separate tc_request_confirmation token
                                    # (field report #73: prompts were accepted in < 1 s without being read)
edit_requires_config_mode = true    # PLC code/project edits refused unless TwinCAT on the target is in CONFIG
# audit_log = 'C:\Users\ryan\.twincat_mcp\audit.jsonl'

[docs]                             # Beckhoff Infosys reference (infosys_* tools), TwinCAT 3 only
enabled = true
source = "local"                   # local = the Help Viewer package XAE installs (every book, offline, no network call)
                                   # web   = infosys.beckhoff.com (sitemap, page fetches, DuckDuckGo fallback)
# mshc = 'C:\ProgramData\Microsoft\HelpLibrary2\Catalogs\VisualStudio15\ContentStore\EN-US\BKINFOSYS3_VS_100_EN-US.2.mshc'
#                                  # default: the newest BKINFOSYS3*.mshc under %ProgramData%\Microsoft\HelpLibrary2
#                                  # local: ONE index of every TwinCAT 3 book, <knowledge folder>\index\infosys-1033.db
#                                  # (else cache_dir); books / exclude_books / tc3_only below apply to source = "web"
books = ["tcplclib_tc2_system", "tcplclib_tc2_standard", "tcplclib_tc2_utilities", "tcplclib_tc3_module",
         "tcplclib_tc2_math", "tcplclib_tc2_iofunctions", "tcplclib_tc3_eventlogger", "tcplclib_tc3_jsonxml"]
# exclude_books = ["^tf5", "^el\\d"]  # regexes on the book slug, on top of the TwinCAT 2 filter
tc3_only = true
max_workers = 6                    # web: parallel page fetches while indexing (keep ≤ 8)
max_index_pages = 4000             # web: cap per infosys_index call
sitemap_ttl_days = 7               # web
web_fallback = true                # web: DuckDuckGo site: search when the index has no hit (never in local mode)
# cache_dir = 'C:\Users\ryan\.twincat_mcp\infosys'
