<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="MAIN" Id="{aaaaaaaa-0000-0000-0000-000000000001}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	fbFill      : FB_Fill;        // main filling sequence
	stRecipe    : ST_Recipe;
	nCycle      : UDINT;
	bStart AT %I* : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[nCycle := nCycle + 1;
fbFill(bEnable := bStart, stRecipe := stRecipe);
IF fbFill.bDone THEN
	GVL_Machine.nDrumsFilled := GVL_Machine.nDrumsFilled + 1;
END_IF]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="2" Count="0" />
      <LineId Id="3" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>
